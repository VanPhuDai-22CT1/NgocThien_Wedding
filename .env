# Local environment variables. Copy to a secure env in production.

# Node
NODE_PATH=src

# Server
PORT=4000

# Database (local MySQL defaults)
DB_NAME=ngocthienwedding
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Connection pool
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Frontend URLs allowed for CORS
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

