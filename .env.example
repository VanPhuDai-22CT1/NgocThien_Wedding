DB_POOL_IDLE=10000

# Server
PORT=4000

# Frontend URL(s) for CORS and same-origin checks
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Optional
NODE_PATH=src
