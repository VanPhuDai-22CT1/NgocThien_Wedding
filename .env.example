# Copy to .env and fill with your local values
# Database
DB_NAME=ngocthienwedding
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_POOL_MAX=10
DB_POOL_MIN=0
