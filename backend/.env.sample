# SMTP configuration for OTP emails
# Set SMTP_HOST and SMTP_USER to your provider values
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Server Config
PORT=5000
NODE_ENV=production

# Database Config
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ngocthienwedding
DB_PORT=3306

# JWT Config
JWT_SECRET=replace_with_strong_random_value
JWT_EXPIRES_IN=7d

# API Config
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
